ROADCLEAR_MODEL_DIR=models
ROADCLEAR_DATA_DIR=runtime
ROADCLEAR_DEVICE=cpu
ROADCLEAR_MAX_UPLOAD_MB=100
ROADCLEAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated model identifiers to explicitly disable:
ROADCLEAR_DISABLED_MODELS=
# Optional system FFmpeg override (otherwise imageio-ffmpeg bundled executable):
# IMAGEIO_FFMPEG_EXE=C:/tools/ffmpeg/bin/ffmpeg.exe
